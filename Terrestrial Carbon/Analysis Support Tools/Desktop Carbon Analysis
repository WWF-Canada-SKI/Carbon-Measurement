function createLegend() {
  legendPanel.clear();

  var makeGradientLegend = function(visParams, title) {
    var legendTitle = ui.Label(title, {
      fontWeight: 'bold',
      margin: '8px 0 4px 8px'
    });

    var colorBar = ui.Thumbnail({
      image: ee.Image.pixelLonLat().select(0).visualize({
        palette: visParams.palette,
        min: 0,
        max: 1
      }),
      params: {
        bbox: '0,0,1,0.1',
        dimensions: '100x10'
      },
      style: {
        stretch: 'horizontal',
        margin: '0 8px',
        maxHeight: '24px'
      },
    });

    var legendLabels = ui.Panel({
      widgets: [
        ui.Label(visParams.min, {margin: '4px 8px'}),
        ui.Label(
          ((visParams.max + visParams.min) / 2).toFixed(1),
          {margin: '4px 8px', textAlign: 'center', stretch: 'horizontal'}
        ),
        ui.Label(visParams.max, {margin: '4px 8px'})
      ],
      layout: ui.Panel.Layout.flow('horizontal')
    });

    legendPanel.add(legendTitle);
    legendPanel.add(colorBar);
    legendPanel.add(legendLabels);
  };

  makeGradientLegend(fcVis, 'Forest Carbon (kg C/m²)');
  makeGradientLegend(scVis, 'Soil Carbon (kg C/m²)');
}

function displayStats(results) {
  resultsPanel.clear();
  resultsPanel.add(ui.Label('Carbon Stock Summary', STYLES.HEADER));

  var stats = results.stats;
  var areaHa = results.area / 10000;
  
  var formatNumber = function(num) {
    if (num === null || num === undefined) return 'N/A';
    return num.toLocaleString('en-US', {maximumFractionDigits: 0});
  };

  resultsPanel.add(ui.Label('AOI Area: ' + areaHa.toFixed(2) + ' hectares'));
  
  var makeStatRow = function(title, mean, stdDev, totalTonnes) {
    var panel = ui.Panel([
      ui.Label(title, STYLES.SUBHEADER),
      ui.Label('Mean Stock: ' + 
               (mean !== null ? mean.toFixed(2) : 'N/A') + 
               ' (±' + 
               (stdDev !== null ? stdDev.toFixed(2) : 'N/A') + 
               ') kg C/m²'),
      ui.Label('Total Stock: ' + formatNumber(totalTonnes) + ' tonnes C')
    ]);
    return panel;
  };
  
  var fcMean = stats.forest_mean, fcStdDev = stats.forest_stdDev;
  var scMean = stats.soil_mean, scStdDev = stats.soil_stdDev;
  
  var fcTotalTonnes = (fcMean * results.area) / 1000;
  var scTotalTonnes = (scMean * results.area) / 1000;
  var totalTonnes = fcTotalTonnes + scTotalTonnes;

  resultsPanel.add(makeStatRow('Forest Carbon', fcMean, fcStdDev, fcTotalTonnes));
  resultsPanel.add(makeStatRow('Soil Carbon', scMean, scStdDev, scTotalTonnes));

  var totalPanel = ui.Panel([
    ui.Label('Total Combined Stock:', {
      fontWeight: 'bold', 
      fontSize: '16px', 
      margin: '16px 0 4px 0'
    }),
    ui.Label(formatNumber(totalTonnes) + ' tonnes C', {
      fontSize: '20px', 
      fontWeight: 'bold', 
      color: STYLES.TITLE.color
    })
  ], null, {
    border: '1px solid ' + STYLES.TITLE.color, 
    padding: '8px', 
    margin: '10px 0 0 0'
  });
  resultsPanel.add(totalPanel);
}

