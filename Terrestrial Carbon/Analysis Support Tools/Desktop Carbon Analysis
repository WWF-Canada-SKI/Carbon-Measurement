// =================================================================================
// === 5. CORE ANALYSIS FUNCTIONS ==================================================
// =================================================================================

function runAnalysis() {
  resultsPanel.clear();
  legendPanel.clear();
  map.layers().reset();
  exportStatusLabel.setValue('');
  
  resultsPanel.add(ui.Label('Calculating...', {color: 'gray'}));

  var aoi = getAoi();
  if (!aoi) {
    resultsPanel.clear();
    return;
  }
  
  AppState.currentAoi = aoi;
  
  map.centerObject(aoi);
  map.addLayer(aoi, STYLES.AOI_STYLE, 'Area of Interest (AOI)');

  var fcClip = forestCarbon.clip(aoi);
  var scClip = soilCarbon.clip(aoi);

  map.addLayer(fcClip, fcVis, 'Forest Carbon (kg/m²)', true);
  map.addLayer(scClip, scVis, 'Soil Carbon (kg/m²)', true);
  
  var combinedCarbon = forestCarbon.rename('forest')
                                   .addBands(soilCarbon.rename('soil'));
  
  var reducer = ee.Reducer.mean()
                  .combine({
                    reducer2: ee.Reducer.stdDev(), 
                    sharedInputs: true
                  });
  
  var stats = combinedCarbon.reduceRegion({
    reducer: reducer, 
    geometry: aoi, 
    scale: 250,
    maxPixels: 1e9
  });
  
  var area = aoi.area({'maxError': 1});

  ee.Dictionary({stats: stats, area: area}).evaluate(function(results, error) {
    if (error) {
      resultsPanel.clear();
      resultsPanel.add(ui.Label('Error: ' + error, {color: 'red'}));
      exportButton.setDisabled(true);
      return;
    }
    
    // Store results for export
    AppState.currentResults = results;
    
    displayStats(results);
    createLegend();
    
    // Enable export button
    exportButton.setDisabled(false);
  });
}

function getAoi() {
  var method = aoiSelection.getValue();
  
  if (method === 'Draw a polygon') {
    var drawLayer = map.drawingTools().layers().get(0);
    
    if (drawLayer.geometries().length() > 0) {
      return drawLayer.getEeObject();
    }
    
    alert('Please draw a polygon on the map first!');
    return null;
    
  } else {
    var assetId = assetIdBox.getValue();
    if (assetId) {
      try {
        return ee.FeatureCollection(assetId).geometry();
      } catch (e) {
        alert('Failed to load asset. Please check the path and your permissions.');
        return null;
      }
    }
    alert('Please enter a valid GEE Asset path!');
    return null;
  }
}

// =================================================================================
// === 6. EXPORT FUNCTIONS =========================================================
// =================================================================================

function exportResults(format) {
  if (!AppState.currentResults) {
    alert('No results to export. Please run the analysis first.');
    return;
  }
  
  var results = AppState.currentResults;
  var stats = results.stats;
  var areaHa = results.area / 10000;
  
  // Calculate totals
  var fcMean = stats.forest_mean;
  var scMean = stats.soil_mean;
  var fcTotalTonnes = (fcMean * results.area) / 1000;
  var scTotalTonnes = (scMean * results.area) / 1000;
  var totalTonnes = fcTotalTonnes + scTotalTonnes;
  
  // Get current date for the export
  var today = new Date();
  var dateStr = today.toISOString().split('T')[0];
  
  // Create feature collection with results as attributes
  var exportFeature = ee.Feature(AppState.currentAoi, {
    'analysis_date': dateStr,
    'data_source': 'Sothe et al. (2022)',
    'aoi_area_ha': areaHa.toFixed(2),
    'forest_carbon_mean_kg_m2': fcMean ? fcMean.toFixed(2) : 'N/A',
    'forest_carbon_stddev_kg_m2': stats.forest_stdDev ? stats.forest_stdDev.toFixed(2) : 'N/A',
    'forest_carbon_total_tonnes': fcTotalTonnes.toFixed(0),
    'soil_carbon_mean_kg_m2': scMean ? scMean.toFixed(2) : 'N/A',
    'soil_carbon_stddev_kg_m2': stats.soil_stdDev ? stats.soil_stdDev.toFixed(2) : 'N/A',
    'soil_carbon_total_tonnes': scTotalTonnes.toFixed(0),
    'total_carbon_tonnes': totalTonnes.toFixed(0)
  });
  
  var exportCollection = ee.FeatureCollection([exportFeature]);
  
  // Determine format parameter
  var formatParam = format === 'CSV' ? 'CSV' : format;
  
  // Generate download URL
  var downloadUrl = exportCollection.getDownloadURL({
    format: formatParam,
    filename: 'carbon_analysis_' + dateStr
  });
  
  // Remove old download link if it exists
  if (downloadLink) {
    panel.remove(downloadLink);
  }
  
  // Create new clickable download link
  downloadLink = ui.Label({
    value: '⬇️ Click here to download ' + format + ' file',
    style: {
      color: '#1976D2',
      textDecoration: 'underline',
      margin: '8px',
      fontSize: '14px',
      fontWeight: 'bold'
    },
    targetUrl: downloadUrl
  });
  
  panel.add(downloadLink);
  exportStatusLabel.setValue('✓ Download link generated successfully!');
  exportStatusLabel.style().set('color', '#388E3C');
  
  print('Download link created for ' + format + ' export');
  print('File includes: AOI geometry + carbon statistics as attributes');
}

